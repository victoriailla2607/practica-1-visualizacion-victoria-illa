df = pd.read_csv("../data/fb441e62df2d58994928907a91895ec62c2c42e6cd075c2700843b89.csv")

df["Date"] = pd.to_datetime(df["Date"])
df["Year"] = df["Date"].dt.year
df["Day"] = df["Date"].dt.strftime("%m-%d")
df["Temperature"] = df["Data_Value"] / 10

# Sacamos el 29 de febrero
df = df[~((df["Date"].dt.month == 2) & (df["Date"].dt.day == 29))]

# Récords entre 2005 y 2014
historico = df[(df["Year"] >= 2005) & (df["Year"] <= 2014)]

maximo = historico[historico["Element"] == "TMAX"].groupby("Day")["Temperature"].max()
minimo = historico[historico["Element"] == "TMIN"].groupby("Day")["Temperature"].min()

# Temperaturas de 2015 que superaron los récords
datos_2015 = df[df["Year"] == 2015]

max_2015 = datos_2015[datos_2015["Element"] == "TMAX"].copy()
min_2015 = datos_2015[datos_2015["Element"] == "TMIN"].copy()

max_2015 = max_2015[max_2015["Temperature"] > max_2015["Day"].map(maximo)]
min_2015 = min_2015[min_2015["Temperature"] < min_2015["Day"].map(minimo)]

# Fechas para el gráfico
maximo.index = pd.to_datetime("2001-" + maximo.index)
minimo.index = pd.to_datetime("2001-" + minimo.index)

plt.figure(figsize=(14, 6))
plt.plot(maximo.index, maximo.values, label="Récord máximo")
plt.plot(minimo.index, minimo.values, label="Récord mínimo")
plt.fill_between(maximo.index, minimo.values, maximo.values, alpha=0.2)

plt.scatter(pd.to_datetime("2001-" + max_2015["Day"]),
            max_2015["Temperature"], label="Máximos de 2015")
plt.scatter(pd.to_datetime("2001-" + min_2015["Day"]),
            min_2015["Temperature"], label="Mínimos de 2015")

plt.title("Temperaturas récord por día del año")
plt.xlabel("Día del año")
plt.ylabel("Temperatura (°C)")
plt.legend()
plt.grid(alpha=0.2)
plt.show()
